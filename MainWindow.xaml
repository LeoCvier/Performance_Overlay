<Window x:Class="PerformanceOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Performance Overlay"
        SizeToContent="WidthAndHeight"
        Height="42"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Grid>
        <Border x:Name="OverlayBackground"
                Background="#A62B3038"
                BorderBrush="#665E6875"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,6">
            <StackPanel x:Name="OverlayContent" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="AvailabilityDot" Width="6" Height="6" Fill="#35DD78"
                         Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                <TextBlock x:Name="FpsAvg" Visibility="Collapsed"/>
                <TextBlock x:Name="Sep1" Text="  │  " Foreground="#AAB0B8" Visibility="Collapsed"/>
                <TextBlock x:Name="FpsMax" Visibility="Collapsed"/>
                <TextBlock x:Name="Sep2" Text="  │  " Foreground="#AAB0B8" Visibility="Collapsed"/>
                <TextBlock x:Name="FpsMin" Visibility="Collapsed"/>
                <TextBlock x:Name="Sep3" Text="  │  " Foreground="#AAB0B8" Visibility="Collapsed"/>
                <TextBlock x:Name="CpuLoad" Visibility="Collapsed"/>
                <TextBlock x:Name="Sep4" Text="  │  " Foreground="#AAB0B8" Visibility="Collapsed"/>
                <TextBlock x:Name="CpuTemp" Visibility="Collapsed"/>
                <TextBlock x:Name="Sep5" Text="  │  " Foreground="#AAB0B8" Visibility="Collapsed"/>
                <TextBlock x:Name="RamLoad" Visibility="Collapsed"/>
                <TextBlock x:Name="Sep6" Text="  │  " Foreground="#AAB0B8" Visibility="Collapsed"/>
                <TextBlock x:Name="GpuLoad" Visibility="Collapsed"/>
                <TextBlock x:Name="Sep7" Text="  │  " Foreground="#AAB0B8" Visibility="Collapsed"/>
                <TextBlock x:Name="GpuTemp" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
        <Rectangle x:Name="ReloadAnimationStroke"
                   IsHitTestVisible="True"
                   RadiusX="8" RadiusY="8"
                   Stroke="#FFB266FF"
                   StrokeThickness="2"
                   StrokeDashArray="10 160"
                   StrokeDashOffset="0"
                   Fill="Transparent"
                   Visibility="Collapsed" />
    </Grid>
</Window>
